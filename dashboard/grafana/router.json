{
  "title": "AgentOps Router",
  "uid": "agentops-router",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Requests/sec by model",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (model) (rate(router_requests_total[1m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p99 latency by model",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (model, le) (rate(router_latency_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens total by model",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (model) (router_tokens_total)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Eval faithfulness",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "eval_faithfulness",
          "legendFormat": "faithfulness"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error rate by model (failed before a model answered)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (model) (rate(router_errors_total[1m])) / clamp_min(sum by (model) (rate(router_requests_total[1m]) + rate(router_errors_total[1m])), 1e-9)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    }
  ]
}
