# embedding sidecars (Track Q): derived local state, rebuilt by --ingest
evals/corpus/cache/

# local runtime — never commit
/logs/
*.log

# locally built binary (releases come from CI tags)
/agentops
/agentops.exe

# local env overrides
.env

